# ── AI API Configuration ──────────────────────────────────────────────────────
# Paste your Google Gemini API Key or OpenAI API Key below:
# (Leave blank to use the built-in high-intelligence AI Supply Chain engine)
GEMINI_API_KEY=

# ── Live Email Dispatch Configuration (SMTP) ──────────────────────────────────
# Configure to enable live Monday 08:00 AM executive email dispatch to planners
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_TLS=true
SMTP_USER=your_email@gmail.com
SMTP_PASS=your_16_char_app_password
SMTP_FROM="Novo Nordisk Supply Chain AI <your_email@gmail.com>"
DIGEST_RECIPIENTS=planner@novonordisk.com,executive@novonordisk.com
